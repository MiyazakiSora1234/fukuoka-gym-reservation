{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "aws-lambda"
    ],
    "lib": [
      "es2023",
      "dom"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "scripts",
    "infra"
  ]
}
