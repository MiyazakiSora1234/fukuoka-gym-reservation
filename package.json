{
  "name": "fukuoka-gym-reservation",
  "version": "0.1.0",
  "private": true,
  "description": "福岡市公共施設案内・予約システムで体育館の個人利用枠を見張り、LINE で通知・予約する",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "node src/watch.ts --once",
    "watch": "node src/watch.ts",
    "login": "node scripts/login.ts",
    "notify:test": "node scripts/test-notify.ts",
    "typecheck": "tsc",
    "synth": "cdk synth --quiet",
    "bootstrap": "node scripts/aws.ts bootstrap",
    "deploy": "node scripts/aws.ts deploy --require-approval never"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.1147.0",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@sparticuz/chromium": "^153.0.0",
    "dotenv": "^18.0.6",
    "playwright": "^1.63.0",
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.4",
    "aws-cdk": "^2.1144.0",
    "aws-cdk-lib": "^2.272.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
